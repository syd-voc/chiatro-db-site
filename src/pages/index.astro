---
import BaseLayout from "../layouts/BaseLayout.astro";
import stats from "../../data/stats.json";
import changelog from "../../data/changelog.json";

const { quizCount, songCount, userCount } = stats;

const sorted = [...changelog].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const firstLogs = sorted.slice(0, 10);
const moreLogs = sorted.slice(10);
---

<BaseLayout title="ちあトロデータベース">
	<h1>トップページ</h1>

	<p>
		早押しイントロクイズ「ちあトロ」の
		<strong>結果ログ・統計閲覧サイト</strong>です。
	</p>

	<hr />

	<section>
		<h2>サイト概要</h2>
		<ul>
			<li>クイズ回数：{quizCount} 回</li>
			<li>登録楽曲数：{songCount} 曲</li>
			<li>参加ユーザー数：{userCount} 人</li>
		</ul>
	</section>

	<section>
		<h2>ページ案内</h2>
		<ul>
			<li>
				<a href="/search"><strong>検索</strong></a>：
				曲名・ID・アーティスト名・参加者名で検索
			</li>
			<li>
				<a href="/quizzes/"><strong>クイズ一覧</strong></a>：
				各回の出題曲・解答ログ・勝ち抜け者
			</li>
			<li>
				<a href="/songs/"><strong>楽曲一覧</strong></a>：
				楽曲情報・出題履歴・正解者一覧
			</li>
			<li>
				<a href="/artists/"><strong>アーティスト一覧</strong></a>：
				使用楽曲一覧
			</li>
			<li>
				<a href="/users/"><strong>参加者一覧</strong></a>：
				個人成績・各種統計情報
			</li>
		</ul>
	</section>

	<section>
		<h2>更新履歴</h2>

		<ul class="changelog">
			{firstLogs.map(log => (
				<li>
					<div class="cl-date">{log.date}</div>
					<div class="cl-title">{log.title}</div>
					<div class="cl-body">{log.body}</div>
				</li>
			))}
		</ul>

		{moreLogs.length > 0 && (
			<>
				<button id="cl-toggle" class="toggle-btn">
					さらに表示（{moreLogs.length}件）
				</button>

				<ul class="changelog" id="cl-more" hidden>
					{moreLogs.map(log => (
						<li>
							<div class="cl-date">{log.date}</div>
							<div class="cl-title">{log.title}</div>
							<div class="cl-body">{log.body}</div>
						</li>
					))}
				</ul>

				<script>
					const btn = document.getElementById("cl-toggle");
					const more = document.getElementById("cl-more");

					if (btn && more) {
						btn.addEventListener("click", () => {
							const open = !more.hidden;
							more.hidden = open;
							btn.textContent = open
								? `さらに表示（${more.children.length}件）`
								: "閉じる";
						});
					}
				</script>
			</>
		)}
	</section>
</BaseLayout>
