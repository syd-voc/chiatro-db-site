---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SortableTable from "../../components/SortableTable.astro";
import userSlugMapRaw from "../../../data/users_slug.json";

const userSlugMap = userSlugMapRaw as Record<string, string>;

function userToSlug(name: string) {
    return userSlugMap[name] ?? encodeURIComponent(name);
}

/* ---------- static paths ---------- */

export async function getStaticPaths() {
    const mods = import.meta.glob("../../../data/artists/*.json", {
        eager: true,
    });
    return Object.values(mods).map((m: any) => ({
        params: { artist: m.default.slug },
        props: { artistData: m.default },
    }));
}

const { artistData } = Astro.props;
const { artist, songs, topUsers } = artistData;

/* ---------- table ---------- */

const songColumns = [
    {
        key: "title",
        label: "曲名",
        sortable: true,
        type: "string",
        render: (r: any) => `<a href="/songs/${r.contentId}">${r.title}</a>`,
    },
    {
        key: "startTime",
        label: "投稿日時",
        sortable: true,
        type: "date",
        render: (row: any) => {
            if (!row.startTime) return "―";
            const d = new Date(row.startTime);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            const hh = String(d.getHours()).padStart(2, "0");
            const min = String(d.getMinutes()).padStart(2, "0");
            return `${yyyy}/${mm}/${dd} ${hh}:${min}`;
        },
    },
    {
        key: "viewCounter",
        label: "再生数",
        sortable: true,
        type: "number",
        render: (row: any) =>
            typeof row.viewCounter === "number"
                ? row.viewCounter.toLocaleString()
                : "―",
    },
    {
        key: "appearanceCount",
        label: "回数",
        sortable: true,
        type: "number",
    },
];
---

<BaseLayout title={`${artist}`}>
    <h1>{artist}</h1>

    <h2>正解数 TOP10</h2>

    <table>
        <tbody>
            {
                topUsers.map((u: any) => (
                    <tr>
                        <td>
                            <a href={`/users/${userToSlug(u.user)}`}>
                                {u.user}
                            </a>
                        </td>
                        <td>{u.count}</td>
                    </tr>
                ))
            }
        </tbody>
    </table>

    <h2>楽曲一覧（{songs.length}曲）</h2>

    <SortableTable
        columns={songColumns}
        rows={songs}
        defaultSortKey="appearanceCount"
        defaultSortOrder="desc"
    />
</BaseLayout>
