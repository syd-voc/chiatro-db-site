---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SortableTable from "../../components/SortableTable.astro";

type ArtistFile = {
    artist: string;
    slug: string;
    songs: {
        contentId: string;
        title: string;
        startTime?: string;
        viewCounter?: number;
        appearanceCount?: number;
    }[];
    topUsers?: { user: string; count: number }[];
};

// ✅ artists JSONだけ読む
const artistModules = import.meta.glob("../../../data/artists/*.json", {
    eager: true,
}) as Record<string, { default: ArtistFile }>;

const artists = Object.values(artistModules)
    .map((m) => m.default)
    .map((a) => ({
        name: a.artist,
        slug: a.slug,
        count: a.songs?.length ?? 0,
    }))
    .sort((a, b) => b.count - a.count);

/* ---------- SortableTable 用 ---------- */

const artistColumns = [
    {
        key: "name",
        label: "アーティスト",
        sortable: true,
        type: "string",
        render: (r: any) => `<a href="/artists/${r.slug}">${r.name}</a>`,
    },
    {
        key: "count",
        label: "曲数",
        sortable: true,
        type: "number",
    },
];
---

<BaseLayout title="アーティスト一覧">
    <h1>アーティスト一覧</h1>

    <SortableTable
        columns={artistColumns}
        rows={artists}
        defaultSortKey="count"
        defaultSortOrder="desc"
    />
</BaseLayout>
