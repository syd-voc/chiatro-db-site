---
import BaseLayout from "../../layouts/BaseLayout.astro";

type ArtistFile = {
    artist: string;
    slug: string;
    songs: {
        contentId: string;
        title: string;
        startTime?: string;
        viewCounter?: number;
        appearanceCount?: number;
    }[];
    topUsers?: { user: string; count: number }[];
};

// ✅ artists JSONだけ読む（軽い）
const artistModules = import.meta.glob("../../../data/artists/*.json", {
    eager: true,
}) as Record<string, { default: ArtistFile }>;

const artists = Object.values(artistModules)
    .map((m) => m.default)
    .map((a) => ({
        name: a.artist,
        slug: a.slug,
        count: a.songs?.length ?? 0,
    }))
    .sort((a, b) => b.count - a.count);
---

<BaseLayout title="アーティスト一覧">
    <h1>アーティスト一覧</h1>

    <table class="song-table">
        <thead>
            <tr>
                <th>アーティスト</th>
                <th>曲数</th>
            </tr>
        </thead>
        <tbody>
            {
                artists.map((a) => (
                    <tr>
                        <td>
                            <a href={`/artists/${a.slug}`}>{a.name}</a>
                        </td>
                        <td>{a.count}</td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</BaseLayout>
