---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Quiz } from "../../types/quiz";

/* ---------- フェーズ定義 ---------- */

const PHASES = [
    { name: "グループなし", start: 21, end: 94 },
    { name: "A〜Bグループ", start: 95, end: 161 },
    { name: "A〜Dグループ", start: 162, end: 209 },
    { name: "A〜Fグループ", start: 210, end: 274 },
    { name: "A〜D2グループ", start: 275, end: Infinity },
];

/* ---------- クイズ読み込み ---------- */

const quizModules = import.meta.glob("../../../data/quizzes/quiz_*.json", {
    eager: true,
}) as Record<string, { default: Quiz }>;

const quizzes = Object.values(quizModules)
    .map((m) => m.default)
    .sort((a, b) => b.quiz_no - a.quiz_no);

/* ---------- フェーズ分割 ---------- */

const phaseGroups = PHASES.map((p) => ({
    ...p,
    quizzes: quizzes.filter((q) => q.quiz_no >= p.start && q.quiz_no <= p.end),
})).map((phase, i, arr) => ({
    ...phase,
    rangeText:
        i === arr.length - 1
            ? `第${phase.start}回〜`
            : `第${phase.start}〜${phase.end}回`,
}));
---

<BaseLayout title="クイズ一覧">
    <h1>クイズ一覧</h1>

    {
        phaseGroups.map((phase, i) => (
            <details open={i === phaseGroups.length - 1}>
                <summary>
                    {phase.name}（{phase.rangeText}）
                </summary>

                <table class="quiz-table">
                    <thead>
                        <tr>
                            <th>回</th>
                            <th>日付</th>
                        </tr>
                    </thead>
                    <tbody>
                        {phase.quizzes.map((q) => (
                            <tr>
                                <td>
                                    <a href={`/quizzes/${q.quiz_no}${q.group}`}>
                                        {q.quiz_no}
                                        {q.group}
                                    </a>
                                </td>
                                <td>{q.date}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </details>
        ))
    }
</BaseLayout>
