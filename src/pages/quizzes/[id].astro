---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Quiz, Song } from "../../types/quiz";
import userSlugMapRaw from "../../../data/users_slug.json";
import artistSlugMapRaw from "../../../data/artists_slug.json";

const userSlugMap = userSlugMapRaw as Record<string, string>;
const artistSlugMap = artistSlugMapRaw as Record<string, string>;

function userToSlug(name: string) {
    return userSlugMap[name] ?? encodeURIComponent(name);
}
function artistToSlug(name: string) {
    return artistSlugMap[name] ?? encodeURIComponent(name);
}

type QuizPageSong = {
    order: number;
    contentId: string;
    answers: any[];
    song: string | null;
    artist: string[];
    thumbnailUrl: string | null;
};

type QuizPage = {
    quiz_no: string;
    group: string;
    date: string;
    id: string;
    songs: QuizPageSong[];
};

/* =========================
   static paths
========================= */
export async function getStaticPaths() {
    const modules = import.meta.glob("../../../data/quiz_pages/*.json", {
        eager: true,
    }) as Record<string, { default: QuizPage }>;

    return Object.values(modules).map((m) => ({
        params: { id: `${m.default.quiz_no}${m.default.group}` },
        props: { quiz: m.default },
    }));
}

const { quiz } = Astro.props;

/* =========================
   helpers
========================= */
const circled = (n: number) => "①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮"[n - 1] ?? n;

function buildTokens(answers: Quiz["songs"][number]["answers"]) {
    const tokens = [];
    let first = true;

    for (const a of answers) {
        if (!first) tokens.push({ type: "sep", value: "→" });
        first = false;

        if (a.result === "SKIP") {
            tokens.push({ type: "sep", value: "・スルー" });
            break;
        }

        if (a.result.startsWith("OK")) {
            const n = Number(a.result.slice(2));
            tokens.push({
                type: "user",
                user: a.user,
                prefix: circled(n),
            });
            break;
        }

        if (a.result.startsWith("WIN")) {
            const n = Number(a.result.slice(3));
            tokens.push({
                type: "user",
                user: a.user,
                prefix: `★(${n})`,
            });
            break;
        }

        if (a.result === "NG") {
            tokens.push({
                type: "user",
                user: a.user,
                prefix: "×",
            });
            continue;
        }

        if (a.result.startsWith("LOSE")) {
            tokens.push({
                type: "user",
                user: a.user,
                prefix: "××",
            });
        }
    }

    return tokens;
}

/* =========================
   win ranking（WINのみ抽出）
========================= */
const winRanking = quiz.songs
    .flatMap((qs) =>
        qs.answers
            .filter((a) => a.result?.startsWith("WIN"))
            .map((a) => ({
                user: a.user,
                order: Number(a.result.slice(3)),
            })),
    )
    .sort((a, b) => a.order - b.order);
---

<BaseLayout title={`第${quiz.quiz_no}${quiz.group}回`}>
    <h1>第{quiz.quiz_no}{quiz.group}回（{quiz.date}）</h1>

    {/* 勝ち抜け */}
    {
        winRanking.length > 0 && (
            <section class="win-ranking">
                <h2>勝ち抜け</h2>
                <ul>
                    {winRanking.map((w) => {
                        const suffix =
                            w.order === 1
                                ? "st"
                                : w.order === 2
                                  ? "nd"
                                  : w.order === 3
                                    ? "rd"
                                    : "th";

                        return (
                            <li>
                                <span class="rank">
                                    {`${w.order}${suffix}`}
                                </span>
                                <a href={`/users/${userToSlug(w.user)}`}>
                                    {w.user}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </section>
        )
    }

    {/* 本編 */}

    {
        quiz.songs.map((qs) => {
            const tokens = buildTokens(qs.answers);

            return (
                <section class="quiz-song">
                    <div class="thumb">
                        {qs.thumbnailUrl ? (
                            <img
                                src={qs.thumbnailUrl}
                                alt={qs.song}
                                loading="lazy"
                            />
                        ) : (
                            <div class="thumb-placeholder" />
                        )}
                    </div>

                    <div class="info">
                        <div class="title">
                            {qs.order}.{" "}
                            <a href={`/songs/${qs.contentId}`}>
                                {qs.song ?? qs.contentId}
                            </a>
                            {qs.artist.length > 0 && (
                                <>
                                    {" / "}
                                    {qs.artist.map((a, i) => (
                                        <>
                                            {i > 0 && " "}
                                            <a
                                                href={`/artists/${artistToSlug(a)}`}
                                            >
                                                {a}
                                            </a>
                                        </>
                                    ))}
                                </>
                            )}
                        </div>

                        <div class="result-line">
                            {tokens.map((t) =>
                                t.type === "sep" ? (
                                    <span class="sep">{t.value}</span>
                                ) : (
                                    <span class="user">
                                        {t.prefix}
                                        <a
                                            href={`/users/${userToSlug(t.user as string)}`}
                                        >
                                            {t.user}
                                        </a>
                                    </span>
                                ),
                            )}
                        </div>
                    </div>
                </section>
            );
        })
    }
</BaseLayout>
