---
import BaseLayout from "../layouts/BaseLayout.astro";
import searchData from "../../data/search_index.json";
---

<BaseLayout title="検索">
  <h2>検索</h2>

  <input id="searchBox" type="text" placeholder="検索ワード" />
  <button id="searchBtn">検索</button>

  <ul id="results"></ul>

  <script
    id="search-data"
    type="application/json"
    set:html={JSON.stringify(searchData)}
  />

  <script>
    const dataEl = document.getElementById("search-data");
    if (!dataEl) throw new Error("search-data not found");

    const DATA = JSON.parse(dataEl.textContent || "{}");

    /** @param {string} s */
    function normalize(str: string): string {
      if (!str) return "";

      return str
        .toLowerCase()
        .normalize("NFKC") // 全角半角統一
        .replace(/[ァ-ン]/g, (s) => String.fromCharCode(s.charCodeAt(0) - 0x60)) // カナ→かな
        .replace(/[\s\-_\/・\.]+/g, ""); // 空白・記号除去
    }
    function scoreMatch(text: string, q: string): number {
      if (!text.includes(q)) return 999;
      if (text === q) return 0;
      if (text.startsWith(q)) return 1;
      return 2;
    }

    /** @param {string} q */
    function run(q: string) {
      const nq = normalize(q);

      if (!nq) {
        const results = document.getElementById(
          "results",
        ) as HTMLUListElement | null;
        if (results) results.innerHTML = "";
        return;
      }

      type Row = { html: string; score: number };
      const rows: Row[] = [];

      /* ===== songs ===== */
      DATA.songs.forEach((s: any) => {
        const id = s.contentId ?? s.id ?? "";

        const scores = [
          scoreMatch(normalize(s.song), nq),
          scoreMatch(normalize(id), nq),
        ];

        const score = Math.min(...scores);
        if (score < 999) {
          rows.push({
            score,
            html: `<li><a href="/songs/${id}">
          ${s.song} / ${
            Array.isArray(s.artist) ? s.artist.join(", ") : s.artist
          }
        </a></li>`,
          });
        }
      });

      /* ===== artists ===== */
      DATA.artists.forEach((a: any) => {
        const score = scoreMatch(normalize(a.name), nq);
        if (score < 999) {
          rows.push({
            score,
            html: `<li><a href="/artists/${a.slug}">
          ${a.name}
        </a></li>`,
          });
        }
      });

      /* ===== users ===== */
      DATA.users.forEach((u: any) => {
        const score = scoreMatch(normalize(u.name), nq);
        if (score < 999) {
          rows.push({
            score,
            html: `<li><a href="/users/${u.slug}">
          ${u.name}
        </a></li>`,
          });
        }
      });

      /* ===== ソート ===== */
      rows.sort((a, b) => a.score - b.score);

      const results = document.getElementById(
        "results",
      ) as HTMLUListElement | null;

      if (results) {
        results.innerHTML = rows.length
          ? rows.map((r) => r.html).join("")
          : "<li>該当なし</li>";
      }
    }

    const searchBox = document.getElementById(
      "searchBox",
    ) as HTMLInputElement | null;
    const searchBtn = document.getElementById(
      "searchBtn",
    ) as HTMLButtonElement | null;

    if (searchBtn && searchBox) {
      searchBtn.onclick = () => run(searchBox.value);

      searchBox.onkeydown = (e) => {
        if (e.key === "Enter") {
          run(searchBox.value);
        }
      };
    }
  </script>
</BaseLayout>
