---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Quiz, Song } from "../../types/quiz";
import SortableTable from "../../components/SortableTable.astro";
import EraCorrectChart from "../../components/EraCorrectChart";
import ViewCorrectChart from "../../components/ViewCorrectChart";

/* =========================
   型補助
========================= */
type QuizSong = Quiz["songs"][number];
type QuizAnswer = QuizSong["answers"][number];

type JoinedQuiz = {
    quiz: Quiz;
    songs: QuizSong[];
};

type CorrectSongStat = {
    contentId: string;
    song: Song;
    correctCount: number;
};

type ArtistStat = {
    artist: string;
    correctCount: number; // 正解回数（延べ）
    songSet: Set<string>; // 正解した曲（重複排除用）
};

type CorrectSongRow = {
    title: string;
    artist: string;
    startTime: string;
    correctCount: number;
    contentId: string;
    artistList: string[];
};

type ArtistStatRow = {
    artist: string;
    correctCount: number;
    correctSongCount: number;
};

type Era =
    | "2007-2008"
    | "2009"
    | "2010"
    | "2011"
    | "2012"
    | "2013"
    | "2014"
    | "2015"
    | "2016"
    | "2017"
    | "2018"
    | "2019"
    | "2020"
    | "2021"
    | "2022"
    | "2023"
    | "2024"
    | "2025-";

export const VIEW_RANGES = [
    { order: 0, key: "-1万", min: 0, max: 9_999 },
    { order: 1, key: "1万-10万", min: 10_000, max: 99_999 },
    { order: 2, key: "10万-30万", min: 100_000, max: 299_999 },
    { order: 3, key: "30万-50万", min: 300_000, max: 499_999 },
    { order: 4, key: "50万-100万", min: 500_000, max: 999_999 },
    { order: 5, key: "100万-200万", min: 1_000_000, max: 1_999_999 },
    { order: 6, key: "200万-300万", min: 2_000_000, max: 2_999_999 },
    { order: 7, key: "300万-500万", min: 3_000_000, max: 4_999_999 },
    { order: 8, key: "500万-1000万", min: 5_000_000, max: 9_999_999 },
    { order: 9, key: "1000万-", min: 10_000_000, max: Infinity },
];

export type ViewRangeKey = (typeof VIEW_RANGES)[number]["key"];

/* =========================
   Static paths
========================= */
export async function getStaticPaths() {
    const quizModules = import.meta.glob("../../../data/quizzes/quiz_*.json", {
        eager: true,
    }) as Record<string, { default: Quiz }>;

    const users = new Set<string>();

    Object.values(quizModules).forEach(({ default: quiz }) => {
        quiz.songs.forEach((qs) => {
            qs.answers.forEach((a) => {
                if (a.user) users.add(a.user);
            });
        });
    });

    return Array.from(users).map((user) => ({
        params: { user },
    }));
}

const { user } = Astro.params as { user: string };

/* =========================
   Load data
========================= */
const quizModules = import.meta.glob("../../../data/quizzes/quiz_*.json", {
    eager: true,
}) as Record<string, { default: Quiz }>;

const songModules = import.meta.glob("../../../data/songs/*.json", {
    eager: true,
}) as Record<string, { default: Song }>;

const quizzes: Quiz[] = Object.values(quizModules).map((m) => m.default);
const songs: Song[] = Object.values(songModules).map((m) => m.default);

/* =========================
   util
========================= */
function findSong(contentId: string): Song | undefined {
    return songs.find((s) => s.contentId === contentId);
}

function circle(num: number) {
    return String.fromCharCode(9311 + num);
}

function summarizeUserResult(quizSongs: QuizSong[], user: string) {
    let ok = 0;
    let ng = 0;
    let winRank: number | null = null;
    let hasLose = false;

    quizSongs.forEach((qs) => {
        const answer = qs.answers.find((a) => a.user === user);
        if (!answer) return;

        if (answer.result.startsWith("OK")) ok++;
        if (answer.result.startsWith("WIN")) {
            ok++;
            const rank = Number(answer.result.replace("WIN", ""));
            if (!Number.isNaN(rank)) {
                winRank = rank;
            }
        }

        if (answer.result.startsWith("NG") || answer.result === "LOSE") {
            ng++;
        }

        if (answer.result === "LOSE") {
            hasLose = true;
        }
    });

    return { ok, ng, winRank, hasLose };
}

function isCorrect(result: string): boolean {
    return result.startsWith("OK") || result.startsWith("WIN");
}

function getEra(startTime?: string): Era | null {
    if (!startTime) return null;

    const year = new Date(startTime).getFullYear();

    if (year <= 2008) return "2007-2008";
    if (year >= 2025) return "2025-";
    return String(year) as Era;
}

function getViewRange(viewCount: number): ViewRangeKey | null {
    const range = VIEW_RANGES.find(
        (r) => viewCount >= r.min && viewCount <= r.max,
    );
    return range?.key ?? null;
}

/* =========================
   build result tokens（quiz と共通構造）
========================= */
function buildTokens(answers: QuizAnswer[]) {
    const tokens: {
        type: "user" | "text";
        value?: string;
        prefix?: string;
        user?: string;
    }[] = [];

    if (answers.length === 0) {
        tokens.push({ type: "text", value: "・スルー" });
        return tokens;
    }

    answers.forEach((a, i) => {
        if (i > 0) tokens.push({ type: "text", value: "→" });

        const num = parseInt(a.result.replace(/\D/g, ""), 10);

        if (a.result.startsWith("OK")) {
            tokens.push({
                type: "user",
                prefix: circle(num),
                user: a.user,
            });
        } else if (a.result.startsWith("WIN")) {
            tokens.push({
                type: "user",
                prefix: `★(${num})`,
                user: a.user,
            });
        } else if (a.result === "NG") {
            tokens.push({
                type: "user",
                prefix: "×",
                user: a.user,
            });
        } else if (a.result === "LOSE") {
            tokens.push({
                type: "user",
                prefix: "××",
                user: a.user,
            });
        } else if (a.result === "SKIP") {
            tokens.push({ type: "text", value: "・スルー" });
        }
    });

    return tokens;
}

/* =========================
   ユーザー参加回抽出
========================= */
const joinedQuizzes = quizzes
    .reduce<JoinedQuiz[]>((acc, quiz) => {
        const hitSongs = quiz.songs.filter((qs: QuizSong) =>
            qs.answers.some((a: QuizAnswer) => a.user === user),
        );

        if (hitSongs.length === 0) return acc;

        acc.push({
            quiz,
            songs: hitSongs,
        });

        return acc;
    }, [])
    .sort((a, b) => Number(b.quiz.quiz_no) - Number(a.quiz.quiz_no));

/* =========================
   正解曲一覧集計
========================= */
const correctSongMap = new Map<string, CorrectSongStat>();

joinedQuizzes.forEach(({ songs: quizSongs }) => {
    quizSongs.forEach((qs) => {
        const answer = qs.answers.find((a) => a.user === user);
        if (!answer) return;

        if (answer.result.startsWith("OK") || answer.result.startsWith("WIN")) {
            const song = findSong(qs.contentId);
            if (!song) return;

            const current = correctSongMap.get(qs.contentId);

            if (current) {
                current.correctCount++;
            } else {
                correctSongMap.set(qs.contentId, {
                    contentId: qs.contentId,
                    song,
                    correctCount: 1,
                });
            }
        }
    });
});

const correctSongs = Array.from(correctSongMap.values());

/* =========================
   アーティスト別集計
========================= */
const artistMap = new Map<string, ArtistStat>();

quizzes.forEach((quiz) => {
    quiz.songs.forEach((qs) => {
        const song = findSong(qs.contentId);
        if (!song) return;

        const correctAnswers = qs.answers.filter(
            (a) => a.user === user && isCorrect(a.result),
        );

        if (correctAnswers.length === 0) return;

        song.artist.forEach((artist) => {
            if (!artistMap.has(artist)) {
                artistMap.set(artist, {
                    artist,
                    correctCount: 0,
                    songSet: new Set(),
                });
            }

            const stat = artistMap.get(artist)!;
            stat.correctCount += correctAnswers.length;
            stat.songSet.add(song.contentId);
        });
    });
});

const artistStats = Array.from(artistMap.values()).map((a) => ({
    artist: a.artist,
    correctCount: a.correctCount,
    correctSongCount: a.songSet.size,
}));

/* =========================
   年別集計
========================= */

type EraStat = {
    era: Era;
    correctCount: number; // 延べ正解回数
    songSet: Set<string>; // 正解した曲ID
};

const eraMap = new Map<Era, EraStat>();

quizzes.forEach((quiz) => {
    quiz.songs.forEach((qs) => {
        const song = findSong(qs.contentId);
        if (!song) return;

        const era = getEra(song.startTime);
        if (!era) return;

        const correctAnswers = qs.answers.filter(
            (a) => a.user === user && isCorrect(a.result),
        );

        if (correctAnswers.length === 0) return;

        if (!eraMap.has(era)) {
            eraMap.set(era, {
                era,
                correctCount: 0,
                songSet: new Set(),
            });
        }

        const stat = eraMap.get(era)!;
        stat.correctCount += correctAnswers.length;
        stat.songSet.add(song.contentId);
    });
});

/* =========================
   再生回数別集計
========================= */

type ViewRangeStat = {
    range: ViewRangeKey;
    correctCount: number; // 延べ正解回数
    songSet: Set<string>; // 正解した曲ID
};

const viewMap = new Map<ViewRangeKey, ViewRangeStat>();

quizzes.forEach((quiz) => {
    quiz.songs.forEach((qs) => {
        const song = findSong(qs.contentId);
        if (!song) return;

        const viewCount = song.viewCounter;
        if (typeof viewCount !== "number") return;

        const range = getViewRange(viewCount);
        if (!range) return;

        const correctAnswers = qs.answers.filter(
            (a) => a.user === user && isCorrect(a.result),
        );

        if (correctAnswers.length === 0) return;

        if (!viewMap.has(range)) {
            viewMap.set(range, {
                range,
                correctCount: 0,
                songSet: new Set(),
            });
        }

        const stat = viewMap.get(range)!;
        stat.correctCount += correctAnswers.length;
        stat.songSet.add(song.contentId);
    });
});

/* =========================
   曲表示用データ生成
========================= */

const correctSongRows: CorrectSongRow[] = correctSongs.map(
    ({ song, correctCount }) => ({
        title: song.song,
        artist: song.artist?.join(" ") ?? "",
        startTime: song.startTime ?? "",
        correctCount,
        contentId: song.contentId,
        artistList: song.artist ?? [],
    }),
);

const correctSongColumns = [
    {
        key: "title",
        label: "曲名",
        sortable: true,
        type: "string",
        render: (row: CorrectSongRow) =>
            `<a href="/songs/${row.contentId}">${row.title}</a>`,
    },
    {
        key: "artist",
        label: "アーティスト",
        sortable: true,
        type: "string",
        render: (row: CorrectSongRow) =>
            row.artistList.length
                ? row.artistList
                      .map((a) => `<a href="/artists/${a}">${a}</a>`)
                      .join(" ")
                : "―",
    },
    {
        key: "startTime",
        label: "投稿日時",
        sortable: true,
        type: "date",
        render: (row: CorrectSongRow) => {
            if (!row.startTime) return "―";
            const d = new Date(row.startTime);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            const hh = String(d.getHours()).padStart(2, "0");
            const min = String(d.getMinutes()).padStart(2, "0");
            return `${yyyy}/${mm}/${dd} ${hh}:${min}`;
        },
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
];

/* =========================
   アーティスト表示用データ生成
========================= */

const artistRows: ArtistStatRow[] = artistStats.map((a) => ({
    artist: a.artist,
    correctCount: a.correctCount,
    correctSongCount: a.correctSongCount,
}));

const artistColumns = [
    {
        key: "artist",
        label: "アーティスト名",
        sortable: true,
        type: "string",
        render: (row: ArtistStatRow) =>
            `<a href="/artists/${row.artist}">${row.artist}</a>`,
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
];

/* =========================
   年別表示用データ生成
========================= */

const eraRows = Array.from(eraMap.values()).map((e) => ({
    era: e.era,
    correctCount: e.correctCount,
    correctSongCount: e.songSet.size,
}));
const eraColumns = [
    {
        key: "era",
        label: "投稿年",
        sortable: true,
        type: "string",
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
] as const;

const eraChartData = eraRows.map((r) => ({
    era: r.era,
    songCount: r.correctSongCount,
    extraCorrect: Math.max(0, r.correctCount - r.correctSongCount),
}));

/* =========================
   再生数帯別表示用データ生成
========================= */
const viewRows = VIEW_RANGES.map((r) => {
    const stat = viewMap.get(r.key);
    return {
        range: r.key, // 表示用
        rangeOrder: r.order, // ソート用
        correctCount: stat?.correctCount ?? 0,
        correctSongCount: stat?.songSet.size ?? 0,
    };
});

const viewColumns = [
    {
        key: "range",
        label: "再生数帯",
        sortable: true,
        type: "number",
        sortKey: "rangeOrder",
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
] as const;

const viewChartData = viewRows.map((r) => ({
    range: r.range,
    songCount: r.correctSongCount,
    extraCorrect: Math.max(0, r.correctCount - r.correctSongCount),
}));
---

<BaseLayout title={`${user}`}>
    <h1>{user}</h1>

    <nav class="user-tabs">
        <button data-tab="quizzes" class="active">参加回</button>
        <button data-tab="songs">正解曲一覧</button>
        <button data-tab="artists">アーティスト別</button>
        <button data-tab="eras">投稿年別</button>
        <button data-tab="views">再生数帯別</button>
    </nav>

    <section class="tab-panel" data-tab-panel="quizzes">
        <h2>参加回一覧（全{joinedQuizzes.length}回）</h2>
        {
            joinedQuizzes.map(({ quiz, songs: quizSongs }) => (
                <details class="quiz-block">
                    <summary>
                        <a href={`/quizzes/${quiz.quiz_no}${quiz.group}`}>
                            第{quiz.quiz_no}
                            {quiz.group}回
                        </a>
                        （{quiz.date}） （
                        {(() => {
                            const { ok, ng, winRank, hasLose } =
                                summarizeUserResult(quizSongs, user);

                            return (
                                <>
                                    {" "}
                                    {ok}○{ng}×
                                    {winRank !== null ? (
                                        <> {winRank}th</>
                                    ) : hasLose ? (
                                        <> LOSE</>
                                    ) : null}
                                </>
                            );
                        })()}
                        ）
                    </summary>

                    {quizSongs.map((qs) => {
                        const song = findSong(qs.contentId);
                        const tokens = buildTokens(qs.answers);

                        return (
                            <section class="quiz-song">
                                {/* サムネ */}
                                <div class="thumb">
                                    {song?.thumbnailUrl ? (
                                        <img
                                            src={song.thumbnailUrl}
                                            alt={song.song}
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="thumb-placeholder" />
                                    )}
                                </div>

                                {/* 情報 */}
                                <div class="info">
                                    <div class="title">
                                        {qs.order}.{" "}
                                        <a href={`/songs/${qs.contentId}`}>
                                            {song?.song ?? qs.contentId}
                                        </a>
                                        {song?.artist?.length ? (
                                            <>
                                                {" "}
                                                /{" "}
                                                {song.artist.map((a, i) => (
                                                    <>
                                                        {i > 0 && " "}
                                                        <a
                                                            href={`/artists/${a}`}
                                                        >
                                                            {a}
                                                        </a>
                                                    </>
                                                ))}
                                            </>
                                        ) : null}
                                    </div>

                                    <div class="result-line">
                                        {tokens.map((t) =>
                                            t.type === "text" ? (
                                                <span class="sep">
                                                    {t.value}
                                                </span>
                                            ) : (
                                                <span class="user">
                                                    {t.prefix}
                                                    <a
                                                        href={`/users/${t.user}`}
                                                    >
                                                        {t.user}
                                                    </a>
                                                </span>
                                            ),
                                        )}
                                    </div>
                                </div>
                            </section>
                        );
                    })}
                </details>
            ))
        }
    </section>

    <section class="tab-panel" data-tab-panel="songs" hidden>
        <h2>正解曲一覧（全{correctSongRows.length}曲）</h2>

        <SortableTable
            columns={correctSongColumns}
            rows={correctSongRows}
            defaultSortKey="correctCount"
            defaultSortOrder="desc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="artists" hidden>
        <h2>アーティスト別 正解数一覧（全{artistRows.length}人）</h2>

        <SortableTable
            columns={artistColumns}
            rows={artistRows}
            defaultSortKey="correctCount"
            defaultSortOrder="desc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="eras" hidden>
        <h2>投稿年別 正解集計</h2>

        <div class="era-chart">
            <EraCorrectChart client:only="react" data={eraChartData} />
        </div>

        <SortableTable
            columns={eraColumns}
            rows={eraRows}
            defaultSortKey="era"
            defaultSortOrder="asc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="views" hidden>
        <h2>再生数帯別 正解集計</h2>

        <div class="view-chart">
            <ViewCorrectChart client:only="react" data={viewChartData} />
        </div>

        <SortableTable
            columns={viewColumns}
            rows={viewRows}
            defaultSortKey="rangeOrder"
            defaultSortOrder="desc"
        />
    </section>
</BaseLayout>

<script defer>
    (() => {
        const tabs = document.querySelectorAll(".user-tabs button");
        const panels = document.querySelectorAll(".tab-panel");

        const params = new URLSearchParams(location.search);
        const initialTab = params.get("tab") || tabs[0]?.dataset.tab;

        function activateTab(tab, push = false) {
            tabs.forEach((btn) => {
                btn.classList.toggle("active", btn.dataset.tab === tab);
            });

            panels.forEach((panel) => {
                const active = panel.dataset.tabPanel === tab;
                panel.hidden = !active;

                if (active) {
                    panel
                        .querySelectorAll(".sortable-table")
                        .forEach((table) => {
                            window.initSortableTable?.(table);
                        });
                }
            });

            if (push) {
                const url = new URL(location.href);
                url.searchParams.set("tab", tab);
                history.pushState({ tab }, "", url);
            }
        }

        // 初期表示
        activateTab(initialTab);

        // クリック
        tabs.forEach((btn) => {
            btn.addEventListener("click", () => {
                activateTab(btn.dataset.tab, true);
            });
        });

        // 戻る / 進む
        window.addEventListener("popstate", (e) => {
            activateTab(e.state?.tab || initialTab);
        });
    })();
</script>
