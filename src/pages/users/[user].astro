---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SortableTable from "../../components/SortableTable.astro";
import EraCorrectChart from "../../components/EraCorrectChart";
import ViewCorrectChart from "../../components/ViewCorrectChart";
import type { Column } from "../../components/SortableTable.astro";
import ScatterCorrectChart from "../../components/ScatterCorrectChart";
import artistSlugMapRaw from "../../../data/artists_slug.json";
const artistSlugMap = artistSlugMapRaw as Record<string, string>;

function artistToSlug(a: string) {
    return artistSlugMap[a] ?? encodeURIComponent(a);
}

/* =========================
   型補助
========================= */

type CorrectSongRow = {
    title: string;
    artist: string;
    startTime: string;
    correctCount: number;
    contentId: string;
    viewCounter: number | undefined;
    artistList: string[];
};

type ArtistStatRow = {
    artist: string;
    correctCount: number;
    correctSongCount: number;
};

export const VIEW_RANGES = [
    { order: 0, key: "-1万", min: 0, max: 9_999 },
    { order: 1, key: "1-10万", min: 10_000, max: 99_999 },
    { order: 2, key: "10-30万", min: 100_000, max: 299_999 },
    { order: 3, key: "30-50万", min: 300_000, max: 499_999 },
    { order: 4, key: "50-100万", min: 500_000, max: 999_999 },
    { order: 5, key: "100-200万", min: 1_000_000, max: 1_999_999 },
    { order: 6, key: "200-300万", min: 2_000_000, max: 2_999_999 },
    { order: 7, key: "300-500万", min: 3_000_000, max: 4_999_999 },
    { order: 8, key: "500-1000万", min: 5_000_000, max: 9_999_999 },
    { order: 9, key: "1000万-", min: 10_000_000, max: Infinity },
];

export type ViewRangeKey = (typeof VIEW_RANGES)[number]["key"];

/* =========================
   Static paths
========================= */
export async function getStaticPaths() {
    const userModules = import.meta.glob("../../../data/users/*.json", {
        eager: true,
    }) as Record<string, { default: any }>;

    return Object.values(userModules).map(({ default: u }) => ({
        params: {
            user: u.slug,
        },
        props: {
            userData: u,
        },
    }));
}

const { userData } = Astro.props;

const {
    user,
    correctSongs,
    artistStats,
    eraStats,
    viewStats,
    scatter,
    summary,
    joinedQuizzes,
} = userData;

function percent(part: number, total: number): number {
    if (total === 0) return 0;
    return (part / total) * 100;
}

/* =========================
   散布図用データ生成
========================= */

type ScatterPoint = {
    title: string;
    contentId: string;
    startTime: number;
    viewCounter: number;
};

const scatterData: ScatterPoint[] = (scatter ?? [])
    .map((s: any) => {
        const ts =
            typeof s.startTime === "number"
                ? s.startTime
                : Date.parse(s.startTime);

        if (!Number.isFinite(ts)) return null;

        return {
            title: s.title,
            contentId: s.contentId,
            startTime: ts,
            viewCounter: Number(s.viewCounter),
        };
    })
    .filter(Boolean) as ScatterPoint[];

/* =========================
   曲表示用データ生成
========================= */

const correctSongRows: CorrectSongRow[] = correctSongs;

const correctSongColumns = [
    {
        key: "title",
        label: "曲名",
        sortable: true,
        type: "string",
        render: (row: CorrectSongRow) =>
            `<a href="/songs/${row.contentId}">${row.title}</a>`,
    },
    {
        key: "artist",
        label: "アーティスト",
        sortable: true,
        type: "string",
        render: (row: CorrectSongRow) =>
            row.artistList.length
                ? row.artistList
                      .map(
                          (a) =>
                              `<a href="/artists/${artistToSlug(a)}">${a}</a>`,
                      )
                      .join(" ")
                : "―",
    },
    {
        key: "startTime",
        label: "投稿日時",
        sortable: true,
        type: "date",
        render: (row: CorrectSongRow) => {
            if (!row.startTime) return "―";
            const d = new Date(row.startTime);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            const hh = String(d.getHours()).padStart(2, "0");
            const min = String(d.getMinutes()).padStart(2, "0");
            return `${yyyy}/${mm}/${dd} ${hh}:${min}`;
        },
    },
    {
        key: "viewCounter",
        label: "再生数",
        sortable: true,
        type: "number",
        render: (row: CorrectSongRow) =>
            typeof row.viewCounter === "number"
                ? row.viewCounter.toLocaleString()
                : "―",
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
];

/* =========================
   アーティスト表示用データ生成
========================= */

const artistRows: ArtistStatRow[] = artistStats;

const artistColumns = [
    {
        key: "artist",
        label: "アーティスト名",
        sortable: true,
        type: "string",
        render: (row: ArtistStatRow) =>
            `<a href="/artists/${artistToSlug(row.artist)}">${row.artist}</a>`,
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
];

/* =========================
年別表示用データ生成（user.json 使用）
========================= */

type EraRow = {
    era: string;
    correctCount: number;
    correctSongCount: number;
    correctPercent: number;
    songPercent: number;
};

const eraRowsBase = eraStats.map((e: any) => ({
    era: e.era,
    correctCount: e.correctCount,
    correctSongCount: e.correctSongCount,
}));

const totalEraCorrect = eraRowsBase.reduce(
    (sum: number, r: EraRow) => sum + r.correctCount,
    0,
);
const totalEraSongs = eraRowsBase.reduce(
    (sum: number, r: EraRow) => sum + r.correctSongCount,
    0,
);

const eraRowsWithPercent: EraRow[] = eraRowsBase.map((r: EraRow) => ({
    ...r,
    correctPercent: percent(r.correctCount, totalEraCorrect),
    songPercent: percent(r.correctSongCount, totalEraSongs),
}));

const eraColumns: Column<EraRow>[] = [
    {
        key: "era",
        label: "投稿年",
        sortable: true,
        type: "string",
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
    {
        key: "songPercent",
        label: "曲数%",
        sortable: true,
        type: "number",
        render: (row) => `${row.songPercent.toFixed(1)}%`,
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctPercent",
        label: "回数%",
        sortable: true,
        type: "number",
        render: (row) => `${row.correctPercent.toFixed(1)}%`,
    },
];

const eraChartData = eraRowsBase.map((r: EraRow) => ({
    era: r.era,
    songCount: r.correctSongCount,
    extraCorrect: Math.max(0, r.correctCount - r.correctSongCount),
}));

/* =========================
再生数帯別表示用データ生成（user.json 使用）
========================= */

type ViewRowBase = {
    range: string;
    rangeOrder: number;
    correctCount: number;
    correctSongCount: number;
};

const viewRowsBase: ViewRowBase[] = viewStats.map((v: any, i: number) => ({
    range: v.range,
    rangeOrder: v.rangeOrder ?? i,
    correctCount: v.correctCount,
    correctSongCount: v.correctSongCount,
}));

const totalViewCorrect = viewRowsBase.reduce(
    (sum, r) => sum + r.correctCount,
    0,
);

const totalViewSongs = viewRowsBase.reduce(
    (sum, r) => sum + r.correctSongCount,
    0,
);

type ViewRowWithPercent = ViewRowBase & {
    correctPercent: number;
    songPercent: number;
};

const viewRowsWithPercent: ViewRowWithPercent[] = viewRowsBase.map((r) => ({
    ...r,
    correctPercent: percent(r.correctCount, totalViewCorrect),
    songPercent: percent(r.correctSongCount, totalViewSongs),
}));

const viewColumns: Column<ViewRowWithPercent>[] = [
    {
        key: "rangeOrder",
        label: "再生数帯",
        sortable: true,
        type: "number",
        render: (row) => row.range,
    },
    {
        key: "correctSongCount",
        label: "正解曲数",
        sortable: true,
        type: "number",
    },
    {
        key: "songPercent",
        label: "曲数%",
        sortable: true,
        type: "number",
        render: (row) => `${row.songPercent.toFixed(1)}%`,
    },
    {
        key: "correctCount",
        label: "正解回数",
        sortable: true,
        type: "number",
    },
    {
        key: "correctPercent",
        label: "回数%",
        sortable: true,
        type: "number",
        render: (row) => `${row.correctPercent.toFixed(1)}%`,
    },
];

const viewChartData = viewRowsBase.map((r) => ({
    range: r.range,
    songCount: r.correctSongCount,
    extraCorrect: Math.max(0, r.correctCount - r.correctSongCount),
}));
---

<BaseLayout title={`${user}`}>
    <h1>{user}</h1>

    <nav class="user-tabs">
        <button data-tab="quizzes" class="active">参加回</button>
        <button data-tab="songs">正解曲一覧</button>
        <button data-tab="artists">アーティスト別</button>
        <button data-tab="eras">投稿年別</button>
        <button data-tab="views">再生数帯別</button>
        <button data-tab="scatter">散布図</button>
        <button data-tab="stats">統計</button>
    </nav>

    <section class="tab-panel" data-tab-panel="quizzes">
        <h2>参加回一覧（全{joinedQuizzes.length}回）</h2>

        {
            joinedQuizzes.map((quiz: any) => (
                <details class="quiz-block">
                    <summary>
                        <a href={`/quizzes/${quiz.quiz_no}${quiz.group}`}>
                            第{quiz.quiz_no}
                            {quiz.group}回
                        </a>
                        （{quiz.date}） （{quiz.ok}○{quiz.ng}×
                        {quiz.winRank !== null ? (
                            <> {quiz.winRank}th</>
                        ) : quiz.hasLose ? (
                            <> LOSE</>
                        ) : null}
                        ）
                    </summary>

                    {quiz.songs.map((qs: any) => (
                        <section class="quiz-song">
                            <div class="thumb">
                                {qs.thumbnailUrl ? (
                                    <img src={qs.thumbnailUrl} loading="lazy" />
                                ) : (
                                    <div class="thumb-placeholder" />
                                )}
                            </div>

                            <div class="info">
                                <div class="title">
                                    {qs.order}.{" "}
                                    <a href={`/songs/${qs.contentId}`}>
                                        {qs.title}
                                    </a>
                                    {qs.artistList.length > 0 && (
                                        <>
                                            {" / "}
                                            {qs.artistList.map(
                                                (a: string, i: number) => (
                                                    <>
                                                        {i > 0 && " "}
                                                        <a
                                                            href={`/artists/${a}`}
                                                        >
                                                            {a}
                                                        </a>
                                                    </>
                                                ),
                                            )}
                                        </>
                                    )}
                                </div>

                                <div class="result-line">
                                    {qs.tokens.map((t: any) =>
                                        t.type === "text" ? (
                                            <span class="sep">{t.value}</span>
                                        ) : (
                                            <span class="user">
                                                {t.prefix}
                                                <a href={`/users/${t.user}`}>
                                                    {t.user}
                                                </a>
                                            </span>
                                        ),
                                    )}
                                </div>
                            </div>
                        </section>
                    ))}
                </details>
            ))
        }
    </section>

    <section class="tab-panel" data-tab-panel="songs" hidden>
        <h2>正解曲一覧（全{correctSongRows.length}曲）</h2>

        <SortableTable
            columns={correctSongColumns}
            rows={correctSongRows}
            defaultSortKey="correctCount"
            defaultSortOrder="desc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="artists" hidden>
        <h2>アーティスト別 正解数一覧（全{artistRows.length}人）</h2>

        <SortableTable
            columns={artistColumns}
            rows={artistRows}
            defaultSortKey="correctCount"
            defaultSortOrder="desc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="eras" hidden>
        <h2>投稿年別 正解集計</h2>

        <div class="era-chart">
            <EraCorrectChart client:only="react" data={eraChartData} />
        </div>

        <SortableTable
            columns={eraColumns}
            rows={eraRowsWithPercent}
            defaultSortKey="era"
            defaultSortOrder="asc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="views" hidden>
        <h2>再生数帯別 正解集計</h2>

        <div class="view-chart">
            <ViewCorrectChart client:only="react" data={viewChartData} />
        </div>

        <SortableTable
            columns={viewColumns}
            rows={viewRowsWithPercent}
            defaultSortKey="rangeOrder"
            defaultSortOrder="desc"
        />
    </section>

    <section class="tab-panel" data-tab-panel="scatter" hidden>
        <h2>正解曲 散布図</h2>

        <ScatterCorrectChart client:only="react" data={scatterData} />
    </section>

    <section class="tab-panel" data-tab-panel="stats" hidden>
        <h2>ユーザー統計</h2>

        <table class="stats-table">
            <tbody>
                <tr>
                    <th>正答率</th>
                    <td>
                        {summary.okAnswers} / {summary.totalAnswers}
                        （{
                            percent(
                                summary.okAnswers,
                                summary.totalAnswers,
                            ).toFixed(1)
                        }%）
                    </td>
                </tr>

                <tr>
                    <th>誤答率</th>
                    <td>
                        {summary.ngAnswers} / {summary.totalAnswers}
                        （{
                            percent(
                                summary.ngAnswers,
                                summary.totalAnswers,
                            ).toFixed(1)
                        }%）
                    </td>
                </tr>

                <tr>
                    <th>勝ち抜け率</th>
                    <td>
                        {summary.winQuizCount} / {summary.participatedQuizCount}
                        （{
                            percent(
                                summary.winQuizCount,
                                summary.participatedQuizCount,
                            ).toFixed(1)
                        }%）
                    </td>
                </tr>

                <tr>
                    <th>失格率</th>
                    <td>
                        {summary.loseQuizCount} / {
                            summary.participatedQuizCount
                        }
                        （{
                            percent(
                                summary.loseQuizCount,
                                summary.participatedQuizCount,
                            ).toFixed(1)
                        }%）
                    </td>
                </tr>

                <tr>
                    <th>正解曲 再生数中央値</th>
                    <td>
                        {
                            summary.medianViews !== null
                                ? summary.medianViews.toLocaleString()
                                : "―"
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
</BaseLayout>

<script defer>
    (() => {
        const tabs = document.querySelectorAll(".user-tabs button");
        const panels = document.querySelectorAll(".tab-panel");

        const params = new URLSearchParams(location.search);
        const initialTab = params.get("tab") || tabs[0]?.dataset.tab;

        function activateTab(tab, push = false) {
            tabs.forEach((btn) => {
                btn.classList.toggle("active", btn.dataset.tab === tab);
            });

            panels.forEach((panel) => {
                const active = panel.dataset.tabPanel === tab;
                panel.hidden = !active;

                if (active) {
                    panel
                        .querySelectorAll(".sortable-table")
                        .forEach((table) => {
                            window.initSortableTable?.(table);
                        });
                }
            });

            if (push) {
                const url = new URL(location.href);
                url.searchParams.set("tab", tab);
                history.pushState({ tab }, "", url);
            }
        }

        // 初期表示
        activateTab(initialTab);

        // クリック
        tabs.forEach((btn) => {
            btn.addEventListener("click", () => {
                activateTab(btn.dataset.tab, true);
            });
        });

        // 戻る / 進む
        window.addEventListener("popstate", (e) => {
            activateTab(e.state?.tab || initialTab);
        });
    })();
</script>
