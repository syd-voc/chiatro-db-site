---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Song, SongHistory } from "../../types/quiz";
import userSlugMapRaw from "../../../data/users_slug.json";
import artistSlugMapRaw from "../../../data/artists_slug.json";

const userSlugMap = userSlugMapRaw as Record<string, string>;
const artistSlugMap = artistSlugMapRaw as Record<string, string>;

function userToSlug(name: string) {
    return userSlugMap[name] ?? encodeURIComponent(name);
}
function artistToSlug(name: string) {
    return artistSlugMap[name] ?? encodeURIComponent(name);
}

export async function getStaticPaths() {
    const pageModules = import.meta.glob("../../../data/song_pages/*.json", {
        eager: true,
    });

    return Object.entries(pageModules).map(([path, mod]) => {
        const data = (mod as { default: any }).default;

        const match = path.match(/([a-z]{2}\d+)\.json$/);
        if (!match) {
            throw new Error(`invalid path: ${path}`);
        }

        const videoId = match[1]; // ✅ string

        return {
            params: { videoId },
            props: { page: data },
        };
    });
}

const { page } = Astro.props as {
    page: {
        song: Song;
        appearanceCount: number;
        correctCount: number;
        accuracy: number;
        histories: SongHistory[];
    };
};

const { song, appearanceCount, correctCount, accuracy, histories } = page;

/* =========================
   ソート（新しい順）
========================= */
const sortedHistories = [...histories].sort(
    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

/* =========================
   投稿日時
========================= */
const postedAt = song.startTime
    ? (() => {
          const d = new Date(song.startTime);
          const pad = (n: number) => String(n).padStart(2, "0");
          return (
              `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ` +
              `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
          );
      })()
    : "−";
---

<BaseLayout title={song.song}>
    <h1>{song.song}</h1>

    <section>
        <h2>動画</h2>

        <div class="player">
            <iframe
                src={`https://embed.nicovideo.jp/watch/${song.contentId}`}
                allowfullscreen></iframe>
        </div>

        <iframe
            src={"https://ext.nicovideo.jp/thumb/" + song.contentId}
            width="390"
            height="220"
            frameborder="0"></iframe>
    </section>

    <section>
        <h2>アーティスト</h2>
        <ul>
            {
                song.artist.map((a: any) => (
                    <li>
                        <a href={`/artists/${artistToSlug(a)}`}>{a}</a>
                    </li>
                ))
            }
        </ul>
    </section>

    <section>
        <h2>情報</h2>

        <table class="info-table">
            <tbody>
                <tr>
                    <th>投稿日時</th>
                    <td>{postedAt}</td>
                    <th>年別順位</th>
                    <td>{song.rank ?? "―"}</td>
                </tr>
                <tr>
                    <th>再生数</th>
                    <td>{song.viewCounter?.toLocaleString() ?? "―"}</td>
                    <th>コメント数</th>
                    <td>{song.commentCounter?.toLocaleString() ?? "―"}</td>
                </tr>
                <tr>
                    <th>いいね！数</th>
                    <td>{song.likeCounter?.toLocaleString() ?? "―"}</td>
                    <th>マイリスト数</th>
                    <td>{song.mylistCounter?.toLocaleString() ?? "―"}</td>
                </tr>
                <tr>
                    <th>タグ</th>
                    <td colspan="3">
                        <ul class="tag-list">
                            {song.tags?.map((tag: string) => <li>{tag}</li>)}
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </section>

    <section>
        <h2>曲データ</h2>
        <ul>
            <li>出題回数：{appearanceCount} 回</li>
            <li>正解回数：{correctCount} 回</li>
            <li>正解率：{accuracy} %</li>
        </ul>
    </section>

    <section>
        <h2>出題履歴</h2>

        {
            sortedHistories.length === 0 ? (
                <p>この曲はまだ出題されていません。</p>
            ) : (
                <table>
                    <thead>
                        <tr>
                            <th>日付</th>
                            <th>回</th>
                            <th>問</th>
                            <th>正解者</th>
                        </tr>
                    </thead>
                    <tbody>
                        {sortedHistories.map((h) => (
                            <tr>
                                <td>{h.date}</td>
                                <td>
                                    <a
                                        href={`/quizzes/${h.quizNo}${h.group ?? ""}`}
                                    >
                                        {h.quizNo}
                                        {h.group}
                                    </a>
                                </td>
                                <td>{h.order}</td>
                                <td>
                                    {h.winner ? (
                                        <a
                                            href={`/users/${userToSlug(h.winner)}`}
                                        >
                                            {h.winner}
                                        </a>
                                    ) : (
                                        "・スルー"
                                    )}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            )
        }
    </section>
</BaseLayout>
