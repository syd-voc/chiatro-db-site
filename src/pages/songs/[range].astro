---
import BaseLayout from "../../layouts/BaseLayout.astro";
import artistSlugMapRaw from "../../../data/artists_slug.json";
const artistSlugMap = artistSlugMapRaw as Record<string, string>;

function artistToSlug(a: string) {
    return artistSlugMap[a] ?? encodeURIComponent(a);
}

export function getStaticPaths() {
    const keys = [
        "2007-2008",
        "2009",
        "2010",
        "2011",
        "2012",
        "2013",
        "2014",
        "2015",
        "2016",
        "2017",
        "2018",
        "2019",
        "2020",
        "2021",
        "2022",
        "2023",
        "2024",
        "2025-",
    ];

    return keys.map((k) => ({
        params: { range: k },
        props: { key: k },
    }));
}

const { key } = Astro.props;

const data = await import(`../../../data/cache/range_${key}.json`);
const stats = data.default;
---

<BaseLayout title={`楽曲一覧 ${key}`}>
    <h1>楽曲一覧（{key}）</h1>

    <table>
        <thead>
            <tr>
                <th>曲名</th>
                <th>アーティスト</th>
                <th>出題回数</th>
            </tr>
        </thead>
        <tbody>
            {
                stats.map((s: any) => (
                    <tr>
                        <td>
                            <a href={`/songs/${s.contentId}`}>{s.song}</a>
                        </td>
                        <td>
                            {s.artist.map((a: string, i: number) => (
                                <>
                                    {i > 0 && " "}
                                    <a href={`/artists/${artistToSlug(a)}`}>
                                        {a}
                                    </a>
                                </>
                            ))}
                        </td>
                        <td>{s.count}</td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</BaseLayout>
