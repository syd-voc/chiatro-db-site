---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SortableTable from "../../components/SortableTable.astro";
import artistSlugMapRaw from "../../../data/artists_slug.json";

const artistSlugMap = artistSlugMapRaw as Record<string, string>;

function artistToSlug(a: string) {
    return artistSlugMap[a] ?? encodeURIComponent(a);
}

/* ---------- static paths ---------- */

export function getStaticPaths() {
    const keys = [
        "2007-2008",
        "2009",
        "2010",
        "2011",
        "2012",
        "2013",
        "2014",
        "2015",
        "2016",
        "2017",
        "2018",
        "2019",
        "2020",
        "2021",
        "2022",
        "2023",
        "2024",
        "2025-",
    ];

    return keys.map((k) => ({
        params: { range: k },
        props: { key: k },
    }));
}

const { key } = Astro.props;

const data = await import(`../../../data/cache/range_${key}.json`);
const stats = data.default;

/* ---------- SortableTable columns ---------- */

const columns = [
    {
        key: "song",
        label: "曲名",
        sortable: true,
        type: "string",
        render: (r: any) => `<a href="/songs/${r.contentId}">${r.song}</a>`,
    },

    {
        key: "artist",
        label: "アーティスト",
        sortable: true,
        type: "string",
        render: (r: any) =>
            (r.artist || [])
                .map(
                    (a: string) =>
                        `<a href="/artists/${artistToSlug(a)}">${a}</a>`,
                )
                .join(" "),
    },

    {
        key: "startTime",
        label: "投稿日時",
        sortable: true,
        type: "date",
        render: (row: any) => {
            if (!row.startTime) return "―";
            const d = new Date(row.startTime);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            const hh = String(d.getHours()).padStart(2, "0");
            const min = String(d.getMinutes()).padStart(2, "0");
            return `${yyyy}/${mm}/${dd} ${hh}:${min}`;
        },
    },

    {
        key: "viewCounter",
        label: "再生数",
        sortable: true,
        type: "number",
        render: (row: any) =>
            typeof row.viewCounter === "number"
                ? row.viewCounter.toLocaleString()
                : "―",
    },

    {
        key: "count",
        label: "出題回数",
        sortable: true,
        type: "number",
    },
];
---

<BaseLayout title={`楽曲一覧（ ${key}）`}>
    <h1>楽曲一覧（{key}）</h1>

    <SortableTable
        columns={columns}
        rows={stats}
        defaultSortKey="count"
        defaultSortOrder="desc"
    />
</BaseLayout>
